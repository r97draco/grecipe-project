PORT=9191
NODE_ENV=development
# Optional: SQLITE_PATH=/absolute/path/to/grecipe.sqlite

# Values from a newly issued Firebase service-account JSON file.
# Use the same Firebase project as client/src/firebase/firebase.js.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value inside double quotes, preserving its \n escapes.
FIREBASE_PRIVATE_KEY=

# Required for recipe generation, not for server startup.
SPOONACULAR_API_KEY=
